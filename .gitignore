/target
**/*.rs.bk

# Native documents and their regenerable cache sidecars
*.fcad
*.fcad-cache
*.fcad-cache-wal
*.fcad-cache-shm

# ...except the regression fixture, which is checked in on purpose: it is a
# document an earlier build wrote, and the point of it is that it does not
# change. A cache sidecar beside it would be, so those stay ignored.
!/crates/ferritecad-fixtures/plate/plate.fcad

# Local OCCT build tree (see docs/build-occt.md)
/vendor/occt
/vendor/install

# Local planegcs build tree and delivery (see docs/build-planegcs.md)
/vendor/planegcs

# CMake build trees (tools/occt-smoke and others)
/build/

# Per-machine tool settings; shared settings belong in .claude/settings.json
.claude/settings.local.json

.DS_Store
