# SPDX-License-Identifier: MIT
#
# The one owner of the Rust SBOM fragment's identity.
#
# Read by tools/generate-rust-sbom.sh and tools/check-rust-sbom.sh, and by the
# workflows through those scripts. A second copy of any version here is a
# second tool: the one that is not pinned still writes a file that looks like
# a CycloneDX document, and nothing about it says which tool produced it.
#
# Neither binary ships in a default feature set, so the install commands that
# go with these pins are:
#   cargo install cargo-cyclonedx --version "$CARGO_CYCLONEDX_VERSION" --locked
#   cargo install jsonschema-cli --version "$JSONSCHEMA_CLI_VERSION" --locked
CARGO_CYCLONEDX_VERSION=0.5.9

# The schema validator. A gate that cannot fail is not a gate, so the version
# that decides schema validity is pinned exactly like the generator's.
JSONSCHEMA_CLI_VERSION=0.51.0

# The specification the fragment claims to conform to, and the exact commit of
# CycloneDX/specification the checked-in schema files were taken from.
# tools/sbom/schema/PROVENANCE.md records the URLs; the digests below are what
# actually binds the files, because a URL can change what it serves.
CYCLONEDX_SPEC_VERSION=1.5
CYCLONEDX_SCHEMA_TAG=1.5
CYCLONEDX_SCHEMA_COMMIT=c320fc0f0b46873864927d9d5684eea7ba439728
CYCLONEDX_SCHEMA_BOM_SHA256=067f7824b08653839ea050ae9e09ca48375eadc2652b0e2a299476e7db90335b
CYCLONEDX_SCHEMA_SPDX_SHA256=4f6e2b05c05d26a4f2dc5879fbc2fca94b0a28db46289d0c51345621b71cfbfc
CYCLONEDX_SCHEMA_JSF_SHA256=8bae002c25e723db7ee1f26afde680ae1a2b1a8f6b4b4b0fd65dc3becb090aae

# The shape of the normalized fragment itself. Bumped when the document layout
# changes in a way a consumer would have to notice; §21A-2b2b0b2b reads it to
# know which fragment format it is merging native components into.
SBOM_FRAGMENT_FORMAT=1
