# SPDX-License-Identifier: MIT
#
# The pinned planegcs and the two libraries it is compiled against, in one
# place.
#
# The tag and the digest are needed by the build script, by the library's own
# provenance string, and by what the Rust lab expects to be told at run time.
# Three copies of a version number drift, and the one that drifts is always the
# one nobody is looking at, so all three read this file.
#
# Eigen and Boost are here for a second reason. planegcs compiles Eigen's
# MPL-2.0 code into the shared library, so the release owes its recipient that
# exact source and the MPL text, and neither is knowable from a header
# directory a package manager happened to leave on a runner. Boost's
# object-code exception means the library itself owes nothing, but which Boost
# produced the build is still part of what the release has to be able to say.
# ADR 0002 records both decisions.
#
# Sourced by tools/build-planegcs.sh and by the solver lab's build script.
# Keep it assignments only: it is read by a shell and parsed by Rust.

FCAD_PLANEGCS_FREECAD_TAG=1.0.1
FCAD_PLANEGCS_FREECAD_URL=https://github.com/FreeCAD/FreeCAD/archive/refs/tags/1.0.1.tar.gz
FCAD_PLANEGCS_ARCHIVE_SHA256=f62bc07c477544eff62b6ab0fc3bb63fa7f1e6f94763c51b0049507842d444f3

FCAD_PLANEGCS_EIGEN_VERSION=3.4.0
FCAD_PLANEGCS_EIGEN_URL=https://gitlab.com/libeigen/eigen/-/archive/3.4.0/eigen-3.4.0.tar.gz
FCAD_PLANEGCS_EIGEN_SHA256=8586084f71f9bde545ee7fa6d00288b264a2b7ac3607b974e54d13e7162c1c72

FCAD_PLANEGCS_BOOST_VERSION=1.91.0
FCAD_PLANEGCS_BOOST_URL=https://archives.boost.io/release/1.91.0/source/boost_1_91_0.tar.gz
FCAD_PLANEGCS_BOOST_SHA256=5734305f40a76c30f951c9abd409a45a2a19fb546efe4162119250bbe4d3a463
