# SPDX-License-Identifier: MIT
#
# The one owner of the notice generator's identity.
#
# Read by tools/generate-rust-notices.sh, tools/check-rust-notices.sh and
# tools/refresh-notice-texts.sh, and by the workflows through those scripts.
# A second copy of this version anywhere executable is refused by
# tools/check-notice-ownership.sh: two copies are two tools, and the one that
# is not the pinned one still produces a file that looks like a notice.
#
# The binary is not shipped by the default feature set, so the install command
# that goes with this pin is:
#   cargo install cargo-about --version "$CARGO_ABOUT_VERSION" --locked --features cli
CARGO_ABOUT_VERSION=0.9.2

# cargo-about's own default. Pinned rather than inherited: the threshold decides
# which shipped licence files are recognised, so a change in the tool's default
# would silently change which packages fall back to a canonical text.
CARGO_ABOUT_THRESHOLD=0.8
